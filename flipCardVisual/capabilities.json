{
  "privileges": [],
  "dataRoles": [
    { "displayName": "Label", "name": "cardLabel", "kind": "Grouping", "description": "Optional category. It labels a single card and supplies identities for Auto or Multiple mode." },
    { "displayName": "Card Value", "name": "cardValue", "kind": "Measure", "description": "Required main value. This is the only required field.", "requiredTypes": [{ "numeric": true }, { "integer": true }] },
    { "displayName": "Detail Value", "name": "detailValue", "kind": "Measure", "description": "Optional back-face detail; visible only when Flip and details is enabled.", "requiredTypes": [{ "numeric": true }, { "integer": true }] },
    { "displayName": "Comparison Value", "name": "comparisonValue", "kind": "Measure", "description": "Optional benchmark value; visually inert until Benchmark and status is enabled.", "requiredTypes": [{ "numeric": true }, { "integer": true }] },
    { "displayName": "Target Value", "name": "targetValue", "kind": "Measure", "description": "Optional preferred status reference; visually inert until Benchmark and status is enabled.", "requiredTypes": [{ "numeric": true }, { "integer": true }] },
    { "displayName": "Tooltips", "name": "tooltips", "kind": "GroupingOrMeasure", "description": "Additional fields included in native Power BI tooltips." }
  ],
  "dataViewMappings": [{
    "conditions": [{ "cardLabel": { "max": 1 }, "cardValue": { "min": 1, "max": 1 }, "detailValue": { "max": 1 }, "comparisonValue": { "max": 1 }, "targetValue": { "max": 1 }, "tooltips": { "max": 20 } }],
    "categorical": {
      "categories": { "for": { "in": "cardLabel" } },
      "values": { "select": [
        { "bind": { "to": "cardValue" } },
        { "bind": { "to": "detailValue" } },
        { "bind": { "to": "comparisonValue" } },
        { "bind": { "to": "targetValue" } },
        { "for": { "in": "tooltips" } }
      ] }
    }
  }],
