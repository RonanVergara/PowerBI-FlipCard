{
    "privileges": [],
    "dataRoles": [
        {
            "displayName": "Card Label",
            "name": "cardLabel",
            "kind": "Grouping"
        },
        {
            "displayName": "Card Value",
            "name": "cardValue",
            "kind": "Measure"
        },
        {
            "displayName": "Detail Value",
            "name": "detailValue",
            "kind": "Measure"
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "cardLabel": {
                        "max": 1
                    },
                    "cardValue": {
                        "max": 1
                    },
                    "detailValue": {
                        "max": 1
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "for": {
                        "in": "cardLabel"
                    }
                },
                "values": {
                    "select": [
                        {
                            "bind": {
                                "to": "cardValue"
                            }
                        },
                        {
                            "bind": {
                                "to": "detailValue"
                            }
                        }
                    ]
                }
            }
        }
    ],
    "objects": {
        "interactions": {
            "properties": {
                "enableFlip": {
                    "type": {
                        "bool": true
                    }
                }
            }
        }
    }
}