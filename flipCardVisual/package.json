{
  "name": "powerbi-smart-kpi-flip-card",
  "description": "A responsive Smart KPI Flip Card custom visual for Microsoft Power BI.",
  "version": "1.1.0",
  "private": true,
  "author": {
    "name": "Ronan Vergara",
    "email": "Vergara.Michael.Ronan@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RonanVergara/PowerBI-FlipCard.git"
  },
  "bugs": {
    "url": "https://github.com/RonanVergara/PowerBI-FlipCard/issues"
  },
  "homepage": "https://github.com/RonanVergara/PowerBI-FlipCard#readme",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11 <12"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "scripts": {
    "dev": "pbiviz start --no-stats --all-locales",
    "build:dev": "pbiviz package --resources --no-pbiviz --no-minify --no-stats --all-locales",
    "build:prod": "pbiviz package --resources --no-pbiviz --no-stats --all-locales",
    "package": "pbiviz package --no-stats --all-locales",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "d3-selection": "3.0.0",
    "powerbi-visuals-api": "5.11.1",
    "powerbi-visuals-utils-dataviewutils": "7.0.0",
    "powerbi-visuals-utils-formattingmodel": "7.1.0",
    "powerbi-visuals-utils-formattingutils": "7.0.0",
    "powerbi-visuals-utils-tooltiputils": "6.0.5"
  },
  "devDependencies": {
    "@types/d3-selection": "3.0.11",
    "@types/node": "24.13.3",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "eslint": "10.8.0",
    "eslint-plugin-powerbi-visuals": "1.1.1",
    "jsdom": "30.0.1",
    "powerbi-visuals-tools": "7.2.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
